# ── Database ───────────────────────────────────────────────
# Leave empty to use the built-in embedded Postgres (PGlite, stored in ./.data).
# For production set a real PostgreSQL connection string (Neon / Supabase / your server).
# Tables are created and products seeded automatically on first start.
# DATABASE_URL=postgres://user:password@host:5432/softsnuggle?sslmode=require
#
# Railway: on the app service set DATABASE_URL = ${{Postgres.DATABASE_URL}}
# (private network, no SSL needed). To reach that database from your own
# computer use the Postgres service's DATABASE_PUBLIC_URL instead, ending in
# ?sslmode=no-verify — Railway's certificate is self-signed, so
# sslmode=require is refused.
DATABASE_URL=

# ── Orders ─────────────────────────────────────────────────
# Owner's WhatsApp number with country code, digits only (91 = India)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Business (merchant) UPI ID and the payee name shown to customers
UPI_ID=softsnuggle@okaxis
UPI_PAYEE_NAME=Soft Snuggle

# Shipping rules (₹)
# 0 = delivery is free on every order, and the wording around the site changes
# to match. Set a figure here to charge it on orders below the free threshold.
# These are NEXT_PUBLIC_, so they are baked in when the server starts:
# restart `next dev` after changing them or the old value sticks.
NEXT_PUBLIC_SHIPPING_FLAT=0
NEXT_PUBLIC_FREE_SHIPPING_ABOVE=1499

# ── Accounts ───────────────────────────────────────────────
# Signs the login cookie. Set a long random value in production:
# running `openssl rand -base64 32` gives a good one.
# Changing it logs everyone out, which is the quickest way to end all sessions.
SESSION_SECRET=

# ── Admin panel (/admin) ───────────────────────────────────
# Google accounts allowed in, comma separated. Removing one locks it out at once.
ADMIN_EMAILS=sankaranarayananr2777@gmail.com,magnertia@gmail.com

# "Sign in with Google", for the admin panel and for shoppers: Google Cloud
# Console → APIs & Services → Credentials → Create OAuth client ID → Web
# application. Authorised redirect URIs (all four):
#   https://<your site>/api/admin/auth/google/callback
#   https://<your site>/api/auth/google/callback
#   http://localhost:3000/api/admin/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
# Shoppers can only use it once the OAuth consent screen is "In production"
# (while it's "Testing", only the test users listed there can sign in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Order emails ───────────────────────────────────────────
# Each order is emailed to everyone in ADMIN_EMAILS, and to the customer when
# they gave an email: cash on delivery as soon as it's placed, UPI once the
# customer enters their UTR. Sent from the shop's Gmail, one of two ways
# (see lib/mail.ts):
#
# 1. The Apps Script relay — what the live site uses, because Railway's Hobby
#    plan blocks SMTP. Set it up from scripts/gmail-relay.gs.
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
#
# 2. Gmail directly over SMTP with an app password made on the GMAIL_USER
#    account (Google Account → Security → 2-Step Verification → App passwords).
#    Works locally and on hosts that allow SMTP.
GMAIL_USER=magnertia@gmail.com
GMAIL_APP_PASSWORD=
#
# With neither set, nothing is sent.
# For working on the email templates: write each email to this folder as an
# .html file instead of sending it.
# MAIL_OUTBOX=./.mail

# The address people visit, used for sign-in redirects and links in emails. Only needed once a
# custom domain is added; otherwise it is worked out from the request.
# SITE_URL=https://softsnuggle.in
